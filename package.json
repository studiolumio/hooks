{
  "name": "@studio-lumio/hooks",
  "version": "0.1.51",
  "description": "a compilation of react hooks we use to make our magic",
  "files": [
    "dist/**/*",
    "bundled/**/*"
  ],
  "sideEffects": false,
  "source": "src/index.ts",
  "babel": {
    "presets": [
      [
        "@babel/preset-typescript",
        {
          "allExtensions": true,
          "isTSX": false
        }
      ]
    ],
    "parserOpts": {
      "plugins": [
        "typescript",
        "jsx"
      ]
    }
  },
  "main": "dist/cjs/index.js",
  "umd:main": "dist/cjs/index.js",
  "module": "dist/cjs/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/cjs/index.js",
      "import": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/studiolumio/hooks.git"
  },
  "scripts": {
    "dev": "vite",
    "push": "npm publish --access public",
    "clean": "npm-run-all --parallel clean:bundled clean:dist",
    "clean:bundled": "rimraf bundled",
    "clean:dist": "rimraf dist",
    "preversion": "npm run build",
    "prepublishOnly": "npm run build",
    "version": "npm run build && git add -A",
    "build": "npm-run-all --parallel clean build:dist build:types",
    "build:types": "tsc -p tsconfig.build.types.json",
    "build:dist": "npm-run-all build:dist:cjs build:dist:esm",
    "build:dist:cjs": "tsc -p tsconfig.build.cjs.json",
    "build:dist:esm": "tsc -p tsconfig.build.esm.json",
    "build:bundle": "npm-run-all build:bundle-full build:bundle-min",
    "build:bundle-full": "microbundle build -i src/index.ts --o ./bundled/hooks.js --no-sourcemap --no-pkg-main --external none --name hooks --format umd  --no-compress",
    "build:bundle-min": "microbundle build -i src/index.ts --o ./bundled/hooks.min.js --no-sourcemap --no-pkg-main --external none --name hooks --format umd --no-compress"
  },
  "keywords": [
    "react",
    "lumio",
    "hooks"
  ],
  "author": "@studiolumio",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/studiolumio/hooks.git"
  },
  "homepage": "https://hooks.studiolumio.com/",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@types/throttle-debounce": "^5.0.0",
    "eslint": "^8.33.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-n": "^15.6.1",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "^7.32.2",
    "microbundle": "^0.15.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^4.9.5",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@types/node": "^18.15.10",
    "js-cookie": "^3.0.8",
    "rimraf": "^4.1.2",
    "throttle-debounce": "^5.0.0"
  },
  "peerDependencies": {
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "pnpm": {
    "overrides": {
      "rollup-plugin-terser": "6.1.0",
      "serialize-javascript": "7.0.5"
    }
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "directories": {
    "doc": "docs"
  }
}
